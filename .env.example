# Non-secret AWS configuration. Credentials belong in the AWS CLI profile,
# environment credential provider, or an attached IAM role, never in this file.
AWS_PROFILE=cloudrestore
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-actual-bucket-name

# Upload size limit in MiB. The app spools file data to disk past 1 MiB.
MAX_UPLOAD_MB=10

# Optional local activity journal path (relative paths resolve from this project).
# The journal contains actions and checksums, not file contents or credentials.
ACTIVITY_LOG_PATH=instance/activity.jsonl
